import os, runpy, traceback

try:
    here = os.path.dirname(os.path.abspath(file))
    runpy.run_path(os.path.join(here, "app_main.py"), run_name="main")
except Exception:
    err = traceback.format_exc()
    from kivy.app import App
    from kivy.uix.textinput import TextInput

    class ErrApp(App):
        def build(self):
            return TextInput(text=err, readonly=True, font_size="12sp")

    ErrApp().run()
